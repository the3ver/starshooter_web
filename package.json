{
  "name": "webproject",
  "version": "1.15.5",
  "description": "Ein klassisches \"Space Shooter\"-Browserspiel, das komplett **ohne HTML5-Canvas** auskommt und stattdessen die Positionierung von DOM-Elementen (via `CSS position: absolute` und `transform`) nutzt.",
  "main": "index.js",
  "scripts": {
    "dev": "http-server src -p 8080 -c-1",
    "start": "http-server src -p 8080 -c-1",
    "test": "playwright test",
    "check": "bash scripts/check.sh",
    "fmt": "prettier --write .",
    "screenshot": "playwright test -c playwright.screenshot.config.js",
    "balancing": "playwright test -c playwright.balancing.config.js",
    "release": "node scripts/version.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the3ver/starshooter_web.git"
  },
